{
  "name": "codeforge-platform",
  "displayName": "CodeForge Platform",
  "description": "Core CodeForge integration for Build Center, AI, MCP, GitHub and Safety Timeline workflows.",
  "version": "0.7.0",
  "publisher": "codeforge",
  "license": "MIT",
  "icon": "media/codeforge.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/bootstrap",
  "enabledApiProposals": [
    "mcpServerDefinitions"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codeforge.openBuildCenter",
    "onCommand:codeforge.build.showHistory",
    "onCommand:codeforge.build.clearHistory",
    "onCommand:codeforge.cancelBuild",
    "onCommand:codeforge.cancelActiveOperations",
    "onCommand:codeforge.publishRecentBuild",
    "onCommand:codeforge.analyzeLastBuild",
    "onCommand:codeforge.applyLastAIFix",
    "onCommand:codeforge.testAIConnection",
    "onCommand:codeforge.setBionicApiKey",
    "onCommand:codeforge.clearBionicApiKey",
    "onCommand:codeforge.openAI",
    "onCommand:codeforge.openMCP",
    "onCommand:codeforge.mcp.manage",
    "onCommand:codeforge.mcp.addServer",
    "onCommand:codeforge.mcp.installed",
    "onCommand:codeforge.mcp.resources",
    "onCommand:codeforge.mcp.openConfig",
    "onCommand:codeforge.openGitHub",
    "onCommand:codeforge.github.signIn",
    "onCommand:codeforge.github.createRepository",
    "onCommand:codeforge.github.readFile",
    "onCommand:codeforge.github.push",
    "onCommand:codeforge.github.pull",
    "onCommand:codeforge.github.sync",
    "onCommand:codeforge.timeline.createCheckpoint",
    "onCommand:codeforge.timeline.show",
    "onCommand:codeforge.timeline.restoreLatest",
    "onCommand:codeforge.timeline.createAIBranch"
  ],
  "scripts": {
    "compile": "gulp compile-extension:codeforge-platform",
    "watch": "gulp watch-extension:codeforge-platform"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeforge",
          "title": "CodeForge",
          "icon": "media/codeforge.png"
        }
      ]
    },
    "views": {
      "codeforge": [
        {
          "id": "codeforge.dashboard",
          "name": "CodeForge"
        }
      ]
    },
    "commands": [
      { "command": "codeforge.openBuildCenter", "title": "CodeForge: Open Build Center" },
      { "command": "codeforge.build.showHistory", "title": "CodeForge: Show Build History" },
      { "command": "codeforge.build.clearHistory", "title": "CodeForge: Clear Build History" },
      { "command": "codeforge.cancelBuild", "title": "CodeForge: Cancel Active Build" },
      { "command": "codeforge.cancelActiveOperations", "title": "CodeForge: Cancel Active Operations" },
      { "command": "codeforge.publishRecentBuild", "title": "CodeForge: Publish Recent Build to GitHub Release" },
      { "command": "codeforge.analyzeLastBuild", "title": "CodeForge: Ask AI Why Last Build Failed" },
      { "command": "codeforge.applyLastAIFix", "title": "CodeForge: Review and Apply Last AI Fix" },
      { "command": "codeforge.testAIConnection", "title": "CodeForge: Test AI Connection" },
      { "command": "codeforge.setBionicApiKey", "title": "CodeForge: Set Bionic API Key Securely" },
      { "command": "codeforge.clearBionicApiKey", "title": "CodeForge: Clear Bionic API Key" },
      { "command": "codeforge.openAI", "title": "CodeForge: Open AI" },
      { "command": "codeforge.openMCP", "title": "CodeForge: Open MCP" },
      { "command": "codeforge.mcp.manage", "title": "CodeForge: Manage MCP Servers" },
      { "command": "codeforge.mcp.addServer", "title": "CodeForge: Add MCP Server" },
      { "command": "codeforge.mcp.installed", "title": "CodeForge: Show Installed MCP Servers" },
      { "command": "codeforge.mcp.resources", "title": "CodeForge: Browse MCP Resources" },
      { "command": "codeforge.mcp.openConfig", "title": "CodeForge: Open MCP Configuration" },
      { "command": "codeforge.openGitHub", "title": "CodeForge: Open GitHub" },
      { "command": "codeforge.github.signIn", "title": "CodeForge: Sign In with GitHub" },
      { "command": "codeforge.github.createRepository", "title": "CodeForge: Create GitHub Repository" },
      { "command": "codeforge.github.readFile", "title": "CodeForge: Read File from GitHub" },
      { "command": "codeforge.github.push", "title": "CodeForge: Push to GitHub" },
      { "command": "codeforge.github.pull", "title": "CodeForge: Pull from GitHub" },
      { "command": "codeforge.github.sync", "title": "CodeForge: Sync GitHub Repository" },
      { "command": "codeforge.timeline.createCheckpoint", "title": "CodeForge: Create Safety Checkpoint" },
      { "command": "codeforge.timeline.show", "title": "CodeForge: Open Safety Timeline" },
      { "command": "codeforge.timeline.restoreLatest", "title": "CodeForge: Restore Latest Safety Checkpoint" },
      { "command": "codeforge.timeline.createAIBranch", "title": "CodeForge: Create Isolated AI Branch" }
    ],
    "configuration": {
      "title": "CodeForge",
      "properties": {
        "codeforge.ai.provider": {
          "type": "string",
          "enum": ["auto", "ollama", "bionic"],
          "default": "auto",
          "description": "AI provider used by CodeForge. Auto tries Ollama first and then Bionic/OpenAI-compatible."
        },
        "codeforge.ai.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local Ollama endpoint."
        },
        "codeforge.ai.bionicEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:1234/v1",
          "description": "Bionic/OpenAI-compatible local endpoint."
        },
        "codeforge.ai.model": {
          "type": "string",
          "default": "auto",
          "description": "Preferred coding model. Use auto to let CodeForge select the best-looking coding model reported by the provider."
        },
        "codeforge.ai.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 5000,
          "maximum": 600000,
          "description": "Maximum time CodeForge waits for an AI analysis request."
        },
        "codeforge.build.autoAnalyzeFailures": {
          "type": "boolean",
          "default": true,
          "description": "Automatically send sanitized build diagnostics to the connected local AI provider when a build fails."
        },
        "codeforge.build.artifactDirectories": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["dist", "release", "releases", "out", "build", "target/release", "app/build/outputs", "android/app/build/outputs"],
          "description": "Workspace-relative directories CodeForge scans for fresh installer/application artifacts after a build."
        },
        "codeforge.build.artifactScanDepth": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum directory depth CodeForge scans inside configured artifact directories."
        },
        "codeforge.build.recentArtifactMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "Time window used by the manual Publish Recent Build command when an exact build start time is not available."
        },
        "codeforge.build.historyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 250,
          "description": "Maximum number of detailed Build Center history entries retained for this workspace."
        },
        "codeforge.github.clientId": {
          "type": "string",
          "default": "Ov23lif1eCdSX5HMnoqU",
          "description": "Public GitHub OAuth Client ID used by the CodeForge desktop PKCE sign-in flow. No client secret is stored in the app."
        },
        "codeforge.github.callbackUrl": {
          "type": "string",
          "default": "http://127.0.0.1/github/callback",
          "description": "Registered loopback callback base URL. CodeForge dynamically adds an available local port during sign-in."
        },
        "codeforge.github.scopes": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["repo", "read:user"],
          "description": "GitHub OAuth scopes requested by CodeForge. Reduce these to limit account access when your workflow allows it."
        },
        "codeforge.github.offerReleaseAfterBuild": {
          "type": "boolean",
          "default": true,
          "description": "Offer to publish fresh installer/application artifacts to a GitHub Release when a CodeForge build finishes."
        },
        "codeforge.mcp.autoSendBuildFailures": {
          "type": "boolean",
          "default": true,
          "description": "Offer to route sanitized build.failed diagnostics to an authorized MCP tool. Every destination requires permission and raw logs or credentials are never sent."
        },
        "codeforge.mcp.buildFailureToolNames": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["build.failed", "build_failed", "analyze_build_failure"],
          "description": "MCP tool names CodeForge may offer for sanitized build failure routing."
        },
        "codeforge.timeline.maxCheckpoints": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 250,
          "description": "Maximum number of local CodeForge Git checkpoint refs retained for a repository."
        },
        "codeforge.timeline.autoCheckpointBeforeBuild": {
          "type": "boolean",
          "default": true,
          "description": "Create a non-destructive Safety Timeline Git checkpoint before starting a detected build."
        },
        "codeforge.shutdown.confirmActiveOperations": {
          "type": "boolean",
          "default": true,
          "description": "Prevent window/app shutdown while CodeForge Build, AI or Git operations are active and ask whether to wait or cancel them."
        }
      }
    }
  }
}
